{
  "name": "@vectojs/danmaku-kit",
  "version": "0.6.0",
  "description": "Reusable track-profile models and canvas-native laboratory UI for VectoJS danmaku applications.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vectojs/danmaku-kit.git"
  },
  "bugs": {
    "url": "https://github.com/vectojs/danmaku-kit/issues"
  },
  "homepage": "https://github.com/vectojs/danmaku-kit#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.mjs",
      "require": "./dist/model.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.mjs",
      "require": "./dist/ui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "scripts": {
    "build": "tsup src/index.ts src/model.ts src/ui.ts --format cjs,esm --clean && tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "test": "bun test",
    "format": "oxfmt --write \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\" \"test/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "format:check": "oxfmt --check \"src/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\" \"test/**/*.{js,ts,jsx,tsx,mjs,cjs,json}\"",
    "lint": "oxlint --deny-warnings src test",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "check": "bun run format:check && bun run lint && bun run lint:md",
    "prepare": "lefthook install"
  },
  "peerDependencies": {
    "@vectojs/core": ">=1.24.0 <2.0.0",
    "@vectojs/danmaku-core": ">=0.2.0 <1.0.0",
    "@vectojs/ui": ">=2.5.0 <3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "@vectojs/core": "^1.27.0",
    "@vectojs/danmaku-core": "0.3.0",
    "@vectojs/ui": "^2.8.0",
    "carryctx": "0.4.4",
    "knip": "^6.31.0",
    "lefthook": "^2.1.10",
    "markdownlint-cli2": "^0.23.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
